rules_version = '2';

// ============================================================
// Nodo Academy · Reglas de seguridad de Firestore
// Pegar en: Firebase → Firestore Database → Reglas → Publicar
// Modelo de datos: sección 8 de la guía.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function autenticado() { return request.auth != null; }
    function esAdmin() {
      return autenticado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function esPropio(userId) { return autenticado() && request.auth.uid == userId; }
    function inscrito(courseId) {
      return autenticado() &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)) &&
        get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active';
    }

    // ---------- users: cada persona lee/edita solo su documento; no puede cambiar su rol ----------
    match /users/{userId} {
      allow read: if esPropio(userId) || esAdmin();
      allow create: if esPropio(userId) && request.resource.data.role == 'student';
      allow update: if (esPropio(userId) && request.resource.data.role == resource.data.role) || esAdmin();
      allow delete: if esAdmin();
    }

    // ---------- courses: público lee los publicados; solo admin escribe ----------
    match /courses/{courseId} {
      allow read: if resource.data.published == true || esAdmin();
      allow write: if esAdmin();
    }

    // ---------- lessons: solo inscritos (o admin) leen; solo admin escribe ----------
    match /lessons/{lessonId} {
      allow read: if esAdmin() || inscrito(resource.data.courseId);
      allow write: if esAdmin();
    }

    // ---------- instructors: público lee (aparecen en el detalle del curso) ----------
    match /instructors/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---------- enrollments: el estudiante lee las suyas; solo backend (Apps Script) y admin escriben ----------
    match /enrollments/{id} {
      allow read: if esAdmin() || (autenticado() && resource.data.userId == request.auth.uid);
      allow write: if esAdmin();
    }

    // ---------- progress: el estudiante crea/lee su propio avance ----------
    match /progress/{id} {
      allow read: if esAdmin() || (autenticado() && resource.data.userId == request.auth.uid);
      allow create: if autenticado() && request.resource.data.userId == request.auth.uid && inscrito(request.resource.data.courseId);
      allow update, delete: if esAdmin();
    }

    // ---------- payments: solo backend y admin escriben; el estudiante ve los suyos ----------
    match /payments/{id} {
      allow read: if esAdmin() || (autenticado() && resource.data.userId == request.auth.uid);
      allow write: if esAdmin();
    }

    // ---------- leads: cualquiera puede crear (formulario público); solo admin lee/edita ----------
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'stage', 'consent'])
                    && request.resource.data.consent == true
                    && request.resource.data.stage == 'nuevo'
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120;
      allow read, update, delete: if esAdmin();
    }

    // ---------- interactions, resources: solo admin ----------
    match /interactions/{id} { allow read, write: if esAdmin(); }
    match /resources/{id} { allow read, write: if esAdmin(); }
  }
}
